{
  "name": "vnn-pipeline",
  "workspace_dir": "/spellbook_data/Serendipity/vnn/workspace",
  "lock_file": ".VNN/pipeline.lock",
  "log_file": ".VNN/execution_log.jsonl",
  "target_lock": true,
  "pre_tick": {
    "callable": "cronpypeline.plugins.vnn_plugin.vnn_pre_tick"
  },
  "post_tick": {
    "callable": "cronpypeline.plugins.vnn_plugin.vnn_post_tick"
  },
  "marker_context": {
    "callable": "cronpypeline.plugins.vnn_plugin.vnn_marker_context"
  },
  "targets": {
    "type": "registry",
    "file": "/spellbook_data/Serendipity/vnn/workspace/countries.json",
    "key": "countries",
    "filter": {"enabled": true}
  },
  "action_handler": {
    "type": "conversation_queue",
    "params": {
      "queue_dir": "/spellbook_data/Serendipity/conversation_queue",
      "agent_settings_dir": "/spellbook_data/Serendipity/agents",
      "prompt_field": "content",
      "default_fields": {
        "sender": "VNN_PIPELINE",
        "conversation_id": "",
        "folder_name": "VNN",
        "model_name": "default_model",
        "runs_left": 3
      },
      "flatten_agent_settings": true
    }
  },
  "stages": [
    {
      "id": "ranking",
      "name": "Ranking — order the compiled stories",
      "trigger": {
        "type": "custom",
        "callable": "cronpypeline.plugins.vnn_plugin.detect_ranking_needed"
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.vnn_prompts.queue_ranking_agent",
          "agent": "RankingAgent"
        }
      },
      "markers": {
        "completion_signal": {"type": "file", "name": "ranking.json", "directory": "{ranking_dir}"},
        "processing": {"type": "json", "name": ".processing_ranking", "content": {}}
      },
      "timeout_minutes": 20,
      "max_retries": 3
    },
    {
      "id": "compilation",
      "name": "Compilation — turn archived links into stories",
      "trigger": {
        "type": "custom",
        "callable": "cronpypeline.plugins.vnn_plugin.detect_compilation_needed"
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.vnn_prompts.queue_compile_agent",
          "agent": "NewsCompilerAgent"
        }
      },
      "markers": {
        "completion_signal": {"type": "file", "name": "compilation_metadata.json"},
        "processing": {"type": "json", "name": ".processing_compilation", "content": {}}
      },
      "timeout_minutes": 20,
      "max_retries": 3
    },
    {
      "id": "research",
      "name": "Research — gather information for the active story",
      "trigger": {
        "type": "custom",
        "callable": "cronpypeline.plugins.vnn_plugin.detect_research_needed"
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.vnn_prompts.queue_research_agent",
          "agent": "NewsResearchAgent"
        }
      },
      "markers": {
        "completion": {"type": "file", "name": "research.md", "directory": "{active_story_dir}"},
        "processing": {"type": "json", "name": ".processing_research", "content": {}}
      },
      "timeout_minutes": 20,
      "max_retries": 3
    },
    {
      "id": "writing",
      "name": "Writing — write the article from the research",
      "trigger": {
        "type": "custom",
        "callable": "cronpypeline.plugins.vnn_plugin.detect_writing_needed"
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.vnn_prompts.queue_writing_agent",
          "agent": "ArticleWriterAgent"
        }
      },
      "markers": {
        "completion": {"type": "file", "name": "article.md", "directory": "{active_story_dir}"},
        "processing": {"type": "json", "name": ".processing_writing", "content": {}}
      },
      "timeout_minutes": 20,
      "max_retries": 3
    },
    {
      "id": "publishing",
      "name": "Publishing — review and publish the article",
      "trigger": {
        "type": "custom",
        "callable": "cronpypeline.plugins.vnn_plugin.detect_publishing_needed"
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.vnn_prompts.queue_publishing_agent",
          "agent": "ArticlePublisherAgent"
        }
      },
      "markers": {
        "completion": {"type": "file", "name": "published.json", "directory": "{active_story_dir}"},
        "processing": {"type": "json", "name": ".processing_publishing", "content": {}}
      },
      "timeout_minutes": 20,
      "max_retries": 3
    },
    {
      "id": "revision",
      "name": "Revision — rewrite a rejected article",
      "trigger": {
        "type": "custom",
        "callable": "cronpypeline.plugins.vnn_plugin.detect_revision_needed"
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.vnn_prompts.queue_revision_agent",
          "agent": "ArticleRevisionAgent"
        }
      },
      "markers": {
        "processing": {"type": "json", "name": ".processing_revision", "content": {}}
      },
      "timeout_minutes": 20,
      "max_retries": 3
    }
  ]
}
