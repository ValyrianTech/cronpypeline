{
  "name": "swe-pipeline",
  "workspace_dir": "/spellbook_data/Serendipity/swe/workspace/repos",
  "lock_file": ".SWE/pipeline.lock",
  "mode_file": ".SWE/mode.json",
  "target_lock": true,
  "config_file": "/spellbook_data/Serendipity/swe/swe_pipeline_config.json",
  "pre_tick": {
    "callable": "cronpypeline.plugins.swe_plugin.sync_session_mode"
  },
  "targets": {
    "type": "registry",
    "file": "/spellbook_data/Serendipity/swe/repos.json",
    "key": "repos",
    "filter": {"enabled": true}
  },
  "action_handler": {
    "type": "conversation_queue",
    "params": {
      "queue_dir": "/spellbook_data/Serendipity/conversation_queue",
      "agent_settings_dir": ".SWE/agent_settings",
      "prompt_field": "content",
      "default_fields": {
        "sender": "SWE_PIPELINE",
        "conversation_id": "",
        "folder_name": "SWE",
        "model_name": "DeepSeek:deepseek-v4-flash",
        "runs_left": 3
      },
      "flatten_agent_settings": true
    }
  },
  "stages": [
    {
      "id": "A0",
      "name": "Queue RepoResearchAgent for repo briefing",
      "trigger": {
        "type": "file_missing",
        "path": ".SWE/repo_briefing.md"
      },
      "action": {
        "type": "queue_agent",
        "params": {
          "agent": "RepoResearchAgent",
          "prompt": "Produce a comprehensive repository briefing for the locally cloned repo at:\n  {target_dir}\n\nFollow your standard briefing format and save the result to '.SWE/repo_briefing.md' (i.e. inside a top-level '.SWE/' subdirectory of the repo). Create the '.SWE/' directory if it does not exist. Use RunCommand / ReadFile / WriteFile as needed.",
          "stage": "A0"
        }
      },
      "markers": {
        "completion": {
          "type": "file",
          "name": "repo_briefing.md",
          "directory": ".SWE"
        },
        "processing": {
          "type": "json",
          "name": ".a0_processing",
          "directory": ".SWE/markers",
          "content": {}
        },
        "give_up": {
          "type": "file",
          "name": ".a0_gave_up",
          "directory": ".SWE/markers"
        }
      },
      "timeout_minutes": 30,
      "max_retries": 3
    },
    {
      "id": "A1-test-infra",
      "name": "Run pytest infrastructure tests",
      "trigger": {
        "type": "and",
        "conditions": [
          {"type": "file_exists", "path": ".SWE/repo_briefing.md"},
          {"type": "file_missing", "path": ".SWE/reports/test-infra/latest.md"}
        ]
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.swe_diagnostics.run_diagnostic",
          "command": "{test_cmd}",
          "report_dir": ".SWE/reports/test-infra",
          "parser": "cronpypeline.plugins.swe_diagnostics.parse_pytest_output",
          "report_title": "Test Infrastructure Check",
          "report_name": "test-infra_{timestamp}.md"
        },
        "timeout_seconds": 900
      },
      "markers": {
        "completion": {
          "type": "symlink",
          "name": "latest.md",
          "directory": ".SWE/reports/test-infra"
        }
      },
      "chain": true
    },
    {
      "id": "A2-lint",
      "name": "Run ruff linter",
      "trigger": {
        "type": "and",
        "conditions": [
          {"type": "file_exists", "path": ".SWE/repo_briefing.md"},
          {"type": "file_missing", "path": ".SWE/reports/lint/latest.md"}
        ]
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.swe_diagnostics.run_diagnostic",
          "command": "{lint_cmd}",
          "report_dir": ".SWE/reports/lint",
          "parser": "cronpypeline.plugins.swe_diagnostics.parse_ruff_output",
          "report_title": "Lint Check",
          "report_name": "lint_{timestamp}.md"
        },
        "timeout_seconds": 600
      },
      "markers": {
        "completion": {
          "type": "symlink",
          "name": "latest.md",
          "directory": ".SWE/reports/lint"
        }
      },
      "chain": true
    },
    {
      "id": "A2-autofix",
      "name": "Apply ruff safe auto-fixes",
      "trigger": {
        "type": "custom",
        "callable": "cronpypeline.plugins.swe_plugin.detect_lint_autofix"
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.swe_plugin.run_lint_autofix",
          "command": "ruff check --fix ."
        }
      },
      "chain": true
    },
    {
      "id": "A2-fix-agent",
      "name": "Queue lint fix agent",
      "trigger": {
        "type": "custom",
        "callable": "cronpypeline.plugins.swe_plugin.detect_lint_fail"
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.swe_prompts.queue_fix_agent",
          "report_path": ".SWE/reports/lint/latest.md",
          "agent": "FixLintingAgent",
          "invalidate_paths": [".SWE/reports/test-infra/latest.md", ".SWE/reports/lint/latest.md"],
          "completion_marker": ".SWE/markers/a2_fix_complete.marker",
          "commit_message": "chore(lint): fix remaining ruff errors",
          "verify_commands": [".venv/bin/ruff check .", ".venv/bin/pytest -q"]
        }
      },
      "markers": {
        "completion": {
          "type": "file",
          "name": "a2_fix_complete.marker",
          "directory": ".SWE/markers"
        },
        "processing": {
          "type": "json",
          "name": ".processing_a2_fix",
          "directory": ".SWE/markers"
        }
      },
      "max_retries": 3,
      "timeout_minutes": 30
    },
    {
      "id": "A3-docstrings",
      "name": "Run interrogate docstring coverage check",
      "trigger": {
        "type": "and",
        "conditions": [
          {"type": "file_exists", "path": ".SWE/repo_briefing.md"},
          {"type": "file_missing", "path": ".SWE/reports/docstrings/latest.md"}
        ]
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.swe_diagnostics.run_diagnostic",
          "command": "{docstring_cmd}",
          "report_dir": ".SWE/reports/docstrings",
          "parser": "cronpypeline.plugins.swe_diagnostics.parse_interrogate_output",
          "report_title": "Docstring Coverage",
          "report_name": "docstrings_{timestamp}.md"
        },
        "timeout_seconds": 600
      },
      "markers": {
        "completion": {
          "type": "symlink",
          "name": "latest.md",
          "directory": ".SWE/reports/docstrings"
        }
      },
      "chain": true
    },
    {
      "id": "A3-fix-agent",
      "name": "Queue docstring fix agent",
      "trigger": {
        "type": "custom",
        "callable": "cronpypeline.plugins.swe_plugin.detect_docstring_fail"
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.swe_prompts.queue_fix_agent",
          "report_path": ".SWE/reports/docstrings/latest.md",
          "agent": "DocStringAgent",
          "invalidate_paths": [".SWE/reports/test-infra/latest.md", ".SWE/reports/lint/latest.md", ".SWE/reports/docstrings/latest.md"],
          "completion_marker": ".SWE/markers/a3_fix_complete.marker",
          "commit_message": "docs: add missing docstrings",
          "verify_commands": [".venv/bin/interrogate -v .", ".venv/bin/pytest -q"]
        }
      },
      "markers": {
        "completion": {
          "type": "file",
          "name": "a3_fix_complete.marker",
          "directory": ".SWE/markers"
        },
        "processing": {
          "type": "json",
          "name": ".processing_a3_fix",
          "directory": ".SWE/markers"
        }
      },
      "max_retries": 3,
      "timeout_minutes": 30
    },
    {
      "id": "A4-mypy",
      "name": "Run mypy type checker",
      "trigger": {
        "type": "and",
        "conditions": [
          {"type": "file_exists", "path": ".SWE/repo_briefing.md"},
          {"type": "file_missing", "path": ".SWE/reports/typecheck/latest.md"}
        ]
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.swe_diagnostics.run_diagnostic",
          "command": "{typecheck_cmd}",
          "report_dir": ".SWE/reports/typecheck",
          "parser": "cronpypeline.plugins.swe_diagnostics.parse_mypy_output",
          "report_title": "Type Check",
          "report_name": "typecheck_{timestamp}.md"
        },
        "timeout_seconds": 600
      },
      "markers": {
        "completion": {
          "type": "symlink",
          "name": "latest.md",
          "directory": ".SWE/reports/typecheck"
        }
      },
      "chain": true
    },
    {
      "id": "A4-fix-agent",
      "name": "Queue type hint fix agent",
      "trigger": {
        "type": "custom",
        "callable": "cronpypeline.plugins.swe_plugin.detect_typecheck_fail"
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.swe_prompts.queue_fix_agent",
          "report_path": ".SWE/reports/typecheck/latest.md",
          "agent": "TypeHintAgent",
          "invalidate_paths": [".SWE/reports/test-infra/latest.md", ".SWE/reports/lint/latest.md", ".SWE/reports/docstrings/latest.md", ".SWE/reports/typecheck/latest.md"],
          "completion_marker": ".SWE/markers/a4_fix_complete.marker",
          "commit_message": "chore(types): add type annotations and fix mypy errors",
          "verify_commands": [".venv/bin/mypy --ignore-missing-imports .", ".venv/bin/pytest -q"]
        }
      },
      "markers": {
        "completion": {
          "type": "file",
          "name": "a4_fix_complete.marker",
          "directory": ".SWE/markers"
        },
        "processing": {
          "type": "json",
          "name": ".processing_a4_fix",
          "directory": ".SWE/markers"
        }
      },
      "max_retries": 3,
      "timeout_minutes": 30
    },
    {
      "id": "A5-bandit",
      "name": "Run bandit security scanner",
      "trigger": {
        "type": "and",
        "conditions": [
          {"type": "file_exists", "path": ".SWE/repo_briefing.md"},
          {"type": "file_missing", "path": ".SWE/reports/security/latest.md"}
        ]
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.swe_plugin.run_a5_bandit",
          "command": "{security_cmd}",
          "report_dir": ".SWE/reports/security",
          "parser": "cronpypeline.plugins.swe_diagnostics.parse_bandit_output",
          "report_title": "Security Audit",
          "report_name": "security_{timestamp}.md"
        }
      },
      "markers": {
        "completion": {
          "type": "symlink",
          "name": "latest.md",
          "directory": ".SWE/reports/security"
        }
      },
      "chain": true
    },
    {
      "id": "A5-fix-agent",
      "name": "Queue security fix agent",
      "trigger": {
        "type": "custom",
        "callable": "cronpypeline.plugins.swe_plugin.detect_security_fail"
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.swe_prompts.queue_fix_agent",
          "report_path": ".SWE/reports/security/latest.md",
          "agent": "SecurityFixAgent",
          "invalidate_paths": [".SWE/reports/test-infra/latest.md", ".SWE/reports/lint/latest.md", ".SWE/reports/security/latest.md"],
          "completion_marker": ".SWE/markers/a5_fix_complete.marker",
          "commit_message": "chore(security): address bandit findings",
          "verify_commands": [".venv/bin/bandit -r . -f txt", ".venv/bin/pytest -q"],
          "extra_instructions": "Requirements:\n- Fix each security issue identified by bandit.\n- Use secure coding practices (e.g. avoid hardcoded secrets, use parameterized queries, use safe deserialization).\n- Do NOT change code logic beyond what's needed for the fix.\n- If a finding is a false positive, add a `# nosec` comment with a brief justification."
        }
      },
      "markers": {
        "completion": {
          "type": "file",
          "name": "a5_fix_complete.marker",
          "directory": ".SWE/markers"
        },
        "processing": {
          "type": "json",
          "name": ".processing_a5_fix",
          "directory": ".SWE/markers"
        }
      },
      "max_retries": 3,
      "timeout_minutes": 30
    },
    {
      "id": "A6-vulture",
      "name": "Run vulture dead code detector",
      "trigger": {
        "type": "custom",
        "callable": "cronpypeline.plugins.swe_plugin.detect_deadcode_trigger"
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.swe_plugin.run_a6_vulture",
          "command": "{deadcode_cmd}",
          "report_dir": ".SWE/reports/deadcode",
          "parser": "cronpypeline.plugins.swe_diagnostics.parse_vulture_output",
          "report_title": "Dead Code",
          "report_name": "deadcode_{timestamp}.md"
        }
      },
      "markers": {
        "completion": {
          "type": "symlink",
          "name": "latest.md",
          "directory": ".SWE/reports/deadcode"
        }
      },
      "chain": true
    },
    {
      "id": "A6-fix-agent",
      "name": "Queue dead code fix agent",
      "trigger": {
        "type": "custom",
        "callable": "cronpypeline.plugins.swe_plugin.detect_vulture_fail"
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.swe_prompts.queue_fix_agent",
          "report_path": ".SWE/reports/deadcode/latest.md",
          "agent": "DeadCodeAgent",
          "invalidate_paths": [".SWE/reports/test-infra/latest.md", ".SWE/reports/lint/latest.md", ".SWE/reports/deadcode/latest.md"],
          "completion_marker": ".SWE/markers/a6_fix_complete.marker",
          "commit_message": "refactor: remove dead code (vulture)",
          "verify_commands": [".venv/bin/vulture {target}/", ".venv/bin/pytest -q"],
          "extra_instructions": "Requirements:\n- Remove genuinely unused imports, functions, methods, variables, and classes.\n- For items that are part of a public API (e.g. exposed in __all__, used by external consumers, or part of an abstract interface), do NOT remove them. Instead add them to a vulture whitelist file at `{target_dir}/vulture_whitelist.py`.\n- Be conservative: if uncertain whether something is truly unused (e.g. called dynamically, used in tests, or via framework magic), add it to the whitelist rather than removing it.\n- Do NOT change code logic."
        }
      },
      "markers": {
        "completion": {
          "type": "file",
          "name": "a6_fix_complete.marker",
          "directory": ".SWE/markers"
        },
        "processing": {
          "type": "json",
          "name": ".processing_a6_fix",
          "directory": ".SWE/markers"
        }
      },
      "max_retries": 3,
      "timeout_minutes": 30
    },
    {
      "id": "A7-coverage",
      "name": "Run pytest with coverage",
      "trigger": {
        "type": "and",
        "conditions": [
          {"type": "file_exists", "path": ".SWE/repo_briefing.md"},
          {"type": "file_missing", "path": ".SWE/reports/coverage/latest.md"}
        ]
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.swe_plugin.run_a7_coverage",
          "command": "",
          "report_dir": ".SWE/reports/coverage",
          "parser": "cronpypeline.plugins.swe_diagnostics.parse_coverage_output",
          "parser_kwargs": {"threshold": 80.0},
          "report_title": "Test Coverage",
          "report_name": "coverage_{timestamp}.md"
        },
        "timeout_seconds": 600
      },
      "markers": {
        "completion": {
          "type": "symlink",
          "name": "latest.md",
          "directory": ".SWE/reports/coverage"
        }
      },
      "chain": true
    },
    {
      "id": "A7-fix-agent",
      "name": "Queue test coverage fix agent",
      "trigger": {
        "type": "custom",
        "callable": "cronpypeline.plugins.swe_plugin.detect_coverage_fail"
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.swe_prompts.queue_fix_agent",
          "report_path": ".SWE/reports/coverage/latest.md",
          "agent": "TestCoverageAgent",
          "invalidate_paths": [".SWE/reports/test-infra/latest.md", ".SWE/reports/coverage/latest.md"],
          "completion_marker": ".SWE/markers/a7_fix_complete.marker",
          "commit_message": "test: add coverage for uncovered code",
          "verify_commands": [".venv/bin/pytest -q"]
        }
      },
      "markers": {
        "completion": {
          "type": "file",
          "name": "a7_fix_complete.marker",
          "directory": ".SWE/markers"
        },
        "processing": {
          "type": "json",
          "name": ".processing_a7_fix",
          "directory": ".SWE/markers"
        }
      },
      "max_retries": 3,
      "timeout_minutes": 30
    },
    {
      "id": "A8-radon",
      "name": "Run radon complexity analysis",
      "trigger": {
        "type": "and",
        "conditions": [
          {"type": "file_exists", "path": ".SWE/repo_briefing.md"},
          {"type": "file_missing", "path": ".SWE/reports/complexity/latest.md"}
        ]
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.swe_plugin.run_a8_radon",
          "command": "{complexity_cmd}",
          "report_dir": ".SWE/reports/complexity",
          "parser": "cronpypeline.plugins.swe_diagnostics.parse_radon_output",
          "parser_kwargs": {"threshold": "C"},
          "report_title": "Complexity",
          "report_name": "complexity_{timestamp}.md"
        }
      },
      "markers": {
        "completion": {
          "type": "symlink",
          "name": "latest.md",
          "directory": ".SWE/reports/complexity"
        }
      },
      "chain": true
    },
    {
      "id": "A9-pip-audit",
      "name": "Run pip-audit dependency scanner",
      "trigger": {
        "type": "and",
        "conditions": [
          {"type": "file_exists", "path": ".SWE/repo_briefing.md"},
          {"type": "file_missing", "path": ".SWE/reports/dep-audit/latest.md"}
        ]
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.swe_plugin.run_a9_dep_audit",
          "command": "pip-audit",
          "report_dir": ".SWE/reports/dep-audit",
          "parser": "cronpypeline.plugins.swe_diagnostics.parse_pip_audit_output",
          "report_title": "Dependency Audit",
          "report_name": "dep-audit_{timestamp}.md"
        }
      },
      "markers": {
        "completion": {
          "type": "symlink",
          "name": "latest.md",
          "directory": ".SWE/reports/dep-audit"
        }
      },
      "chain": true
    },
    {
      "id": "B1-fetch-issues",
      "name": "Fetch open issues from GitHub",
      "trigger": {
        "type": "custom",
        "callable": "cronpypeline.plugins.swe_plugin.detect_b1_issue_gathering"
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.swe_plugin.run_b1_issue_gathering"
        }
      }
    },
    {
      "id": "C-review-ranking",
      "name": "Queue IssueTriageAgent to pick most important review issue",
      "trigger": {
        "type": "custom",
        "callable": "cronpypeline.plugins.swe_plugin.detect_c_review_ranking"
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.swe_plugin.run_c_review_ranking"
        }
      },
      "markers": {
        "completion": {
          "type": "json",
          "name": "review_ranked.json",
          "directory": ".SWE/markers"
        },
        "processing": {
          "type": "json",
          "name": ".processing_c_review_ranking",
          "directory": ".SWE/markers"
        }
      },
      "max_retries": 3,
      "timeout_minutes": 30
    },
    {
      "id": "C-pr-review",
      "name": "Queue PRReviewAgent for published PR",
      "trigger": {
        "type": "custom",
        "callable": "cronpypeline.plugins.swe_plugin.detect_c_pr_review"
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.swe_plugin.run_c_pr_review"
        }
      },
      "markers": {
        "completion": {
          "type": "json",
          "name": "pr_reviewed.json",
          "directory": ".SWE"
        },
        "processing": {
          "type": "json",
          "name": ".processing_c_pr_review",
          "directory": ".SWE/markers"
        }
      },
      "max_retries": 3,
      "timeout_minutes": 30
    },
    {
      "id": "C-issue-fix",
      "name": "Drive SELECT/GATE state machine for issue fixes",
      "trigger": {
        "type": "custom",
        "callable": "cronpypeline.plugins.swe_plugin.detect_c_issue_fix"
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.swe_plugin.run_c_issue_fix"
        }
      }
    },
    {
      "id": "C-pr-status",
      "name": "Poll GitHub PR for merge/reject/changes-requested",
      "trigger": {
        "type": "custom",
        "callable": "cronpypeline.plugins.swe_plugin.detect_c_pr_status"
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.swe_plugin.run_c_pr_status"
        }
      }
    },
    {
      "id": "C-session-terminal",
      "name": "Close discarded GitHub session",
      "trigger": {
        "type": "and",
        "conditions": [
          {
            "type": "custom",
            "callable": "cronpypeline.plugins.swe_plugin.detect_session_complete"
          },
          {
            "type": "file_missing",
            "path": ".SWE/markers/session_finalized.marker"
          }
        ]
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.swe_plugin.finalize_session"
        }
      },
      "markers": {
        "completion": {
          "type": "file",
          "name": "session_finalized.marker",
          "directory": ".SWE/markers"
        }
      },
      "modes": ["github"]
    },
    {
      "id": "C-coverage",
      "name": "Create coverage issue when coverage < 100%",
      "trigger": {
        "type": "custom",
        "callable": "cronpypeline.plugins.swe_plugin.detect_c_coverage_issue"
      },
      "action": {
        "type": "custom",
        "params": {
          "callable": "cronpypeline.plugins.swe_plugin.run_c_coverage_issue"
        }
      }
    },
    {
      "id": "C-review",
      "name": "Create review issue when coverage == 100%",
      "trigger": {
        "type": "custom",
        "callable": "cronpypeline.plugins.swe_plugin.detect_c_review_issue"
